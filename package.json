{
  "name": "moro-native",
  "version": "1.0.0",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "vite --mode native",
    "dev:native": "vite --mode native",
    "dev:web": "vite --mode web",
    "build": "pnpm run build:native",
    "build:native": "pnpm run build:workers && vite build --mode native",
    "build:web": "pnpm run build:workers && vite build --mode web",
    "preview": "vite preview --mode native --outDir dist-native",
    "preview:native": "vite preview --mode native --outDir dist-native",
    "preview:web": "vite preview --mode web --outDir dist-web",
    "cap:sync": "pnpm run build:native && cap sync",
    "cap:sync:android": "pnpm run build:native && cap sync android",
    "cap:sync:ios": "pnpm run build:native && cap sync ios",
    "cap:android": "pnpm run cap:sync:android && cap open android",
    "cap:ios": "pnpm run cap:sync:ios && cap open ios",
    "build:android": "pnpm run cap:sync:android",
    "build:ios": "pnpm run cap:sync:ios",
    "sync:native": "node scripts/sync-native.mjs",
    "deploy:worker": "wrangler deploy --config wrangler.toml",
    "build:workers": "node scripts/build-workers.mjs",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/ios": "6.2.1",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/live-updates": "0.3.1",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@neondatabase/serverless": "^1.0.2",
    "@netlify/blobs": "^10.7.4",
    "@netlify/functions": "^5.1.5",
    "@phosphor-icons/react": "^2.1.10",
    "@rei-standard/amsg-client": "2.5.0",
    "@rei-standard/amsg-instant": "0.9.1",
    "@rei-standard/amsg-server": "2.5.1",
    "@rei-standard/amsg-shared": "0.2.0",
    "@rei-standard/amsg-sw": "2.3.1",
    "html2canvas": "1.4.1",
    "jszip": "^3.10.1",
    "katex": "0.16.11",
    "pdfjs-dist": "3.11.174",
    "pg": "^8.20.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-legacy": "5.4.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "10.4.21",
    "esbuild": "^0.21.5",
    "fake-indexeddb": "^6.2.5",
    "postcss": "8.5.14",
    "tailwindcss": "3.4.17",
    "terser": "5.31.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^2.1.9",
    "wrangler": "^3.114.17"
  }
}
